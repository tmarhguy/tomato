        <entry>
          <string>Testdata</string>
          <testData>
            <dataString>reset clk pc-out ir-opcode ctrl-reg-we ctrl-w-sel mem-addr reg-b m-out reg-w-data

# hold (main reset=1) — sync sequencer while held
1 0 x x x x x x x x
1 1 x x x x x x x x
1 0 x x x x x x x x
1 1 x x x x x x x x
# run (main reset=0) — release with clk low, then first edge
0 0 x x x x x x x x
0 0 x x x x x x x x
0 1 x x x x x x x x
# FETCH ADDI @ PC=0
0 0 x x x x x x x x
0 1 x x x x x x x x
# EXECUTE ADDI R1=4 (pc-out=1 on clk=1)
0 1 1 0x10 1 0 x x x 4
0 0 x x x x x x x x
0 1 x x x x x x x x
# FETCH LW0 @ PC=1
0 0 x x x x x x x x
0 1 x x x x x x x x
# EXECUTE LW0 — load 0x42 from mem[4] into R2 (pc-out=2, sample clk=0)
0 0 2 0x35 1 3 4 4 0x42 0x42
</dataString>
          </testData>
        </entry>
      </elementAttributes>
