    <visualElement>
      <elementName>Testcase</elementName>
      <elementAttributes>
        <entry>
          <string>Label</string>
          <string>add-arithmetic-only</string>
        </entry>
        <entry>
          <string>Testdata</string>
          <testData>
            <dataString>reset clk alu-out ir-opcode ctrl-alu-op
1 0 x x x
1 1 x x x
1 0 x x x
# EXECUTE ADDI R0=0: microcode dispatches alu-op=0x96 (XOR3/ADD)
1 1 0 0x10 0x96
1 0 x x x
1 1 x x x
1 0 x x x
# EXECUTE ADDI R1=10: R0+imm=0+10=10
1 1 10 0x10 0x96
1 0 x x x
1 1 x x x
1 0 x x x
# EXECUTE ADDI R2=10: R0+imm=0+10=10
1 1 10 0x10 0x96
1 0 x x x
1 1 x x x
1 0 x x x
# EXECUTE ADD R2+=R1: post-writeback alu-out=R2_new+R1=20+10=30
1 1 30 0x01 0x96
1 0 x x x
1 1 x x x
1 0 x x x
# EXECUTE JMP: ALU unused, ctrl-alu-op=0x00
1 1 x 0x62 0x00
</dataString>
          </testData>
        </entry>
      </elementAttributes>
      <pos x="300" y="-700"/>
    </visualElement>
