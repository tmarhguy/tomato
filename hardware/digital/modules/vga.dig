    <visualElement>
      <elementName>Testcase</elementName>
      <elementAttributes>
        <entry>
          <string>Label</string>
          <string>vga-tile-write-read</string>
        </entry>
        <entry>
          <string>Testdata</string>
          <testData>
            <dataString>mem_addr mem_din disp-read-addr clk disp-data-out

# Tile RAM: CPU write port A, scan-out read port B. disp-data-out = {lo16, hi16}.
0x000000 0x00000000 0 0 0x00000000
0xF10000 0xFFFF0041 0 0 x
0xF10000 0xFFFF0041 0 C 0x41FFFF
0xF10004 0x0000FF42 4 0 x
0xF10004 0x0000FF42 4 C 0xFF420000
0xF10000 0xFFFF0041 0 0 0x41FFFF
</dataString>
          </testData>
        </entry>
      </elementAttributes>
      <pos x="-560" y="200"/>
    </visualElement>
    <visualElement>
      <elementName>Testcase</elementName>
      <elementAttributes>
        <entry>
          <string>Label</string>
          <string>vga-dual-port-poll</string>
        </entry>
        <entry>
          <string>Testdata</string>
          <testData>
            <dataString>mem_addr mem_din disp-read-addr clk disp-data-out

# Dual-port: poll read addr 0 while CPU writes addr 4; MMIO addr does not hit tile 0.
0x000000 0x00000000 0 0 0x00000000
0xF10000 0x07E00041 0 0 x
0xF10000 0x07E00041 0 C 0x4107E0
0xF10004 0xF8000042 0 0 0x4107E0
0xF10004 0xF8000042 0 C 0x4107E0
0xF10004 0xF8000042 4 0 0x42F800
0xF10000 0x07E00041 0 0 0x4107E0
0xF00018 0xDEADBEEF 0 0 0x4107E0
0xF00018 0xDEADBEEF 0 C 0x4107E0
</dataString>
          </testData>
        </entry>
      </elementAttributes>
