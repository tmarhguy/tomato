    <visualElement>
      <elementName>Testcase</elementName>
      <elementAttributes>
        <entry>
          <string>Label</string>
          <string>ir tests</string>
        </entry>
        <entry>
          <string>Testdata</string>
          <testData>
            <dataString>CLK LOAD DATA_IN IR_BUS OPCODE ADDR_A ADDR_B ADDR_W ADDR_ABS OFFSET COND MUX1_SEL MUX2_SEL

# A — LOAD=0 never captures
C 1 0x00000000 0x00000000 0x00 0x00 0x00 0x00 0x000000 0x000000 0 0 0
0 0 0xDEADBEEF 0x00000000 0x00 0x00 0x00 0x00 0x000000 0x000000 0 0 0
C 0 0xDEADBEEF 0x00000000 0x00 0x00 0x00 0x00 0x000000 0x000000 0 0 0
C 1 0x01020304 0x01020304 0x01 0x02 0x03 0x04 0x020304 0x020304 4 0 0

# B — slice spot-check words
# zeros
C 1 0x00000000 0x00000000 0x00 0x00 0x00 0x00 0x000000 0x000000 0 0 0
0 1 0x00000000 0x00000000 0x00 0x00 0x00 0x00 0x000000 0x000000 0 0 0
# distinct bytes
C 1 0x01020304 0x01020304 0x01 0x02 0x03 0x04 0x020304 0x020304 4 0 0
0 1 0x01020304 0x01020304 0x01 0x02 0x03 0x04 0x020304 0x020304 4 0 0
# all ones
C 1 0xFFFFFFFF 0xFFFFFFFF 0xFF 0xFF 0xFF 0xFF 0xFFFFFF 0xFFFFFF 7 1 1
0 1 0xFFFFFFFF 0xFFFFFFFF 0xFF 0xFF 0xFF 0xFF 0xFFFFFF 0xFFFFFF 7 1 1
# pattern
C 1 0xCAFEBABE 0xCAFEBABE 0xCA 0xFE 0xBA 0xBE 0xFEBABE 0xFEBABE 6 0 1
0 1 0xCAFEBABE 0xCAFEBABE 0xCA 0xFE 0xBA 0xBE 0xFEBABE 0xFEBABE 6 0 1
# low byte 07
C 1 0x00000007 0x00000007 0x00 0x00 0x00 0x07 0x000007 0x000007 7 1 1
0 1 0x00000007 0x00000007 0x00 0x00 0x00 0x07 0x000007 0x000007 7 1 1
# opcode byte 0x00
C 1 0x00010203 0x00010203 0x00 0x01 0x02 0x03 0x010203 0x010203 3 1 1
0 1 0x00010203 0x00010203 0x00 0x01 0x02 0x03 0x010203 0x010203 3 1 1
# opcode byte 0x01
C 1 0x01010203 0x01010203 0x01 0x01 0x02 0x03 0x010203 0x010203 3 1 1
0 1 0x01010203 0x01010203 0x01 0x01 0x02 0x03 0x010203 0x010203 3 1 1
# opcode byte 0x02
C 1 0x02010203 0x02010203 0x02 0x01 0x02 0x03 0x010203 0x010203 3 1 1
0 1 0x02010203 0x02010203 0x02 0x01 0x02 0x03 0x010203 0x010203 3 1 1
# opcode byte 0x03
C 1 0x03010203 0x03010203 0x03 0x01 0x02 0x03 0x010203 0x010203 3 1 1
0 1 0x03010203 0x03010203 0x03 0x01 0x02 0x03 0x010203 0x010203 3 1 1
# opcode byte 0x04
C 1 0x04010203 0x04010203 0x04 0x01 0x02 0x03 0x010203 0x010203 3 1 1
0 1 0x04010203 0x04010203 0x04 0x01 0x02 0x03 0x010203 0x010203 3 1 1
# opcode byte 0x05
C 1 0x05010203 0x05010203 0x05 0x01 0x02 0x03 0x010203 0x010203 3 1 1
0 1 0x05010203 0x05010203 0x05 0x01 0x02 0x03 0x010203 0x010203 3 1 1
# opcode byte 0x06
C 1 0x06010203 0x06010203 0x06 0x01 0x02 0x03 0x010203 0x010203 3 1 1
0 1 0x06010203 0x06010203 0x06 0x01 0x02 0x03 0x010203 0x010203 3 1 1
# opcode byte 0x07
C 1 0x07010203 0x07010203 0x07 0x01 0x02 0x03 0x010203 0x010203 3 1 1
0 1 0x07010203 0x07010203 0x07 0x01 0x02 0x03 0x010203 0x010203 3 1 1
# opcode byte 0x08
C 1 0x08010203 0x08010203 0x08 0x01 0x02 0x03 0x010203 0x010203 3 1 1
0 1 0x08010203 0x08010203 0x08 0x01 0x02 0x03 0x010203 0x010203 3 1 1
# opcode byte 0x09
C 1 0x09010203 0x09010203 0x09 0x01 0x02 0x03 0x010203 0x010203 3 1 1
0 1 0x09010203 0x09010203 0x09 0x01 0x02 0x03 0x010203 0x010203 3 1 1
# opcode byte 0x0A
C 1 0x0A010203 0x0A010203 0x0A 0x01 0x02 0x03 0x010203 0x010203 3 1 1
0 1 0x0A010203 0x0A010203 0x0A 0x01 0x02 0x03 0x010203 0x010203 3 1 1
# opcode byte 0x0B
C 1 0x0B010203 0x0B010203 0x0B 0x01 0x02 0x03 0x010203 0x010203 3 1 1
0 1 0x0B010203 0x0B010203 0x0B 0x01 0x02 0x03 0x010203 0x010203 3 1 1
# opcode byte 0x0C
C 1 0x0C010203 0x0C010203 0x0C 0x01 0x02 0x03 0x010203 0x010203 3 1 1
0 1 0x0C010203 0x0C010203 0x0C 0x01 0x02 0x03 0x010203 0x010203 3 1 1
# opcode byte 0x0D
C 1 0x0D010203 0x0D010203 0x0D 0x01 0x02 0x03 0x010203 0x010203 3 1 1
0 1 0x0D010203 0x0D010203 0x0D 0x01 0x02 0x03 0x010203 0x010203 3 1 1
# opcode byte 0x0E
C 1 0x0E010203 0x0E010203 0x0E 0x01 0x02 0x03 0x010203 0x010203 3 1 1
0 1 0x0E010203 0x0E010203 0x0E 0x01 0x02 0x03 0x010203 0x010203 3 1 1
# opcode byte 0x0F
C 1 0x0F010203 0x0F010203 0x0F 0x01 0x02 0x03 0x010203 0x010203 3 1 1
