    <visualElement>
      <elementName>Testcase</elementName>
      <elementAttributes>
        <entry>
          <string>Label</string>
          <string>ir-layout-decode</string>
        </entry>
        <entry>
          <string>Testdata</string>
          <testData>
            <dataString>CLK LOAD DATA_IN ir-sel RegB OPCODE ADDR_A ADDR_B ADDR_W BANK_SEL ADDR_ABS OFFSET COND MUX1_SEL MUX2_SEL ir-imm-out

# 10|6|6|6|4 field split (opcode[31:22] ra rb rd bank[3:0]) — latch then read
# enc: op=0x2AF ra=0x0D rb=0x04 rd=0x23 bank=4
0 0 0xABCD1234 0 0 x x x x x x x x x x x
0 1 0xABCD1234 0 0 x x x x x x x x x x x
C 1 0xABCD1234 0 0 x x x x x x x x x x x
0 0 0xABCD1234 0 0 0x2AF 0x0D 0x04 0x23 4 0xD1234 0xD1234 4 0 0 x

# NOP opcode all-zero operand zone
0 0 0x00000000 0 0 x x x x x x x x x x x
0 1 0x00000000 0 0 x x x x x x x x x x x
C 1 0x00000000 0 0 x x x x x x x x x x x
0 0 0x00000000 0 0 0x000 0x00 0x00 0x00 0 0x000000 0x000000 0 0 0 x

# reg-reg word: ADD ra=1 rb=2 rd=3 bank=11 (op=0x001)
0 0 0x0041083B 0 0 x x x x x x x x x x x
0 1 0x0041083B 0 0 x x x x x x x x x x x
C 1 0x0041083B 0 0 x x x x x x x x x x x
0 0 0x0041083B 0 0 0x001 0x01 0x02 0x03 11 0x1083B 0x1083B 3 1 1 x
</dataString>
          </testData>
        </entry>
      </elementAttributes>
      <pos x="160" y="-640"/>
    </visualElement>
    <visualElement>
      <elementName>Testcase</elementName>
      <elementAttributes>
        <entry>
          <string>Label</string>
          <string>ir-addr-ctrl</string>
        </entry>
        <entry>
          <string>Testdata</string>
          <testData>
            <dataString>CLK LOAD DATA_IN ir-sel RegB OPCODE ADDR_A ADDR_B ADDR_W BANK_SEL ADDR_ABS OFFSET COND MUX1_SEL MUX2_SEL ir-imm-out

# ADDR_ABS/OFFSET = IR[21:0]; COND=IR[2:0]; BANK_SEL=IR[3:0] (low nibble)
0 0 0x003FFFFF 0 0 x x x x x x x x x x x
0 1 0x003FFFFF 0 0 x x x x x x x x x x x
C 1 0x003FFFFF 0 0 x x x x x x x x x x x
0 0 0x003FFFFF 0 0 0x000 0x3F 0x3F 0x3F 15 0x3FFFFF 0x3FFFFF 7 1 1 x

# jump-style: bank=1 operand payload 0x155000
0 0 0x00155001 0 0 x x x x x x x x x x x
0 1 0x00155001 0 0 x x x x x x x x x x x
C 1 0x00155001 0 0 x x x x x x x x x x x
0 0 0x00155001 0 0 0x000 0x15 0x14 0x00 1 0x155001 0x155001 1 1 0 x
</dataString>
          </testData>
        </entry>
      </elementAttributes>
      <pos x="400" y="-640"/>
    </visualElement>
    <visualElement>
      <elementName>Testcase</elementName>
      <elementAttributes>
        <entry>
          <string>Label</string>
          <string>ir-imm-decode</string>
        </entry>
        <entry>
          <string>Testdata</string>
          <testData>
            <dataString>CLK LOAD DATA_IN ir-sel RegB OPCODE ADDR_A ADDR_B ADDR_W BANK_SEL ADDR_ABS OFFSET COND MUX1_SEL MUX2_SEL ir-imm-out

# sel=0 pass-through RegB
0 0 0x00000000 0 0xABCD0000 x x x x x x x x x x x
0 1 0x00000000 0 0xABCD0000 x x x x x x x x x x x
C 1 0x00000000 0 0xABCD0000 x x x x x x x x x x x
0 0 0x00000000 0 0xABCD0000 0x000 0x00 0x00 0x00 0 0x000000 0x000000 0 0 0 0xABCD0000

# sel=2 8b_sign IR[7:0]=0xFB (-5)
0 0 0x000000FB 2 0 x x x x x x x x x x x
0 1 0x000000FB 2 0 x x x x x x x x x x x
C 1 0x000000FB 2 0 x x x x x x x x x x x
0 0 0x000000FB 2 0 x x x x x x x x x x 0xFFFFFFFB

# sel=3 12b_sign from ir-bus[11:0] (word 0x400 yields 1 with current taps)
0 0 0x00000400 3 0 x x x x x x x x x x x
0 1 0x00000400 3 0 x x x x x x x x x x x
C 1 0x00000400 3 0 x x x x x x x x x x x
0 0 0x00000400 3 0 x x x x x x x x x x 0x00000001

# sel=5 SHAMT — ir-bus[12:8] tap (0x500: shamt field overlaps rd; imm=0 today)
0 0 0x00000500 5 0 x x x x x x x x x x x
0 1 0x00000500 5 0 x x x x x x x x x x x
C 1 0x00000500 5 0 x x x x x x x x x x x
0 0 0x00000500 5 0 x x x x x x x x x x 0x00000000

# sel=7 16b_zero IR[15:0]=0x1234
0 0 0x00001234 7 0 x x x x x x x x x x x
0 1 0x00001234 7 0 x x x x x x x x x x x
C 1 0x00001234 7 0 x x x x x x x x x x x
0 0 0x00001234 7 0 x x x x x x x x x x 0x00001234

# sel=11 LUI20 (ir-bus[21:4] shifted — word 0x1234500)
0 0 0x01234500 11 0 x x x x x x x x x x x
0 1 0x01234500 11 0 x x x x x x x x x x x
C 1 0x01234500 11 0 x x x x x x x x x x x
0 0 0x01234500 11 0 x x x x x x x x x x 0x8D140000

# sel=14 imm22z zero_ext(IR[21:0]) — word 0x00054321
0 0 0x00054321 14 0 x x x x x x x x x x x
0 1 0x00054321 14 0 x x x x x x x x x x x
C 1 0x00054321 14 0 x x x x x x x x x x x
0 0 0x00054321 14 0 x x x x x x x x x x 0x00054321

# sel=15 imm6s sign_ext(IR[14:9]) — IR[14:9]=6&apos;b111111 (-1)
0 0 0x00007FC0 15 0 x x x x x x x x x x x
0 1 0x00007FC0 15 0 x x x x x x x x x x x
C 1 0x00007FC0 15 0 x x x x x x x x x x x
0 0 0x00007FC0 15 0 x x x x x x x x x x 0xFFFFFFFF
</dataString>
          </testData>
        </entry>
      </elementAttributes>
      <pos x="660" y="-640"/>
    </visualElement>
