  <visualElement>
      <elementName>Testcase</elementName>
      <elementAttributes>
        <entry>
          <string>Label</string>
          <string>regfile-exhaustive</string>
        </entry>
        <entry>
          <string>Testdata</string>
          <testData>
            <dataString>clk WE EXEC DATA_W ADDR_A ADDR_B ADDR_W addr_c_sel IR_ADDR_CIN DATA_A DATA_B DATA_C
# 1. Unwritten memory reads as zero (combinational)
0 0 0 0x00000000 0 0 0 0 0 0x00000000 0x00000000 0x00000000
0 0 0 0x00000000 1 2 0 1 0x2A 0x00000000 0x00000000 0x00000000
0 0 0 0x00000000 0xFF 0x80 0 0 0 0x00000000 0x00000000 0x00000000
# 2. WRITE_REG — EXEC=1 WE=1 on clk posedge
