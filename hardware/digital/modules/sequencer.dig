    <visualElement>
      <elementName>Testcase</elementName>
      <elementAttributes>
        <entry>
          <string>Label</string>
          <string>Sequencer Exhaustive</string>
        </entry>
        <entry>
          <string>Testdata</string>
          <testData>
            <dataString>reset cycles CLK FETCH EXECUTE MEM_WAIT

# Hold (reset=0): counter cleared — FETCH
0 0 0 1 0 0
0 0 C 1 0 0

# Release run (reset=1), cycles=0: single-phase (FETCH only)
1 0 0 1 0 0
1 0 C 1 0 0
1 0 C 1 0 0

# cycles=1: FETCH -&gt; EXECUTE -&gt; FETCH (2 phases)
1 1 0 1 0 0
1 1 C 0 1 0
1 1 C 1 0 0
1 1 C 0 1 0
1 1 C 1 0 0

# cycles=2: FETCH -&gt; EXECUTE -&gt; MEM_WAIT -&gt; FETCH (3 phases)
1 2 0 1 0 0
1 2 C 0 1 0
1 2 C 0 0 1
1 2 C 1 0 0
1 2 C 0 1 0
1 2 C 0 0 1
1 2 C 1 0 0

# cycles=3: four counter steps (through RESERVED) — terminal reload at 11
1 3 0 1 0 0
1 3 C 0 1 0
1 3 C 0 0 1
1 3 C 0 0 0
1 3 C 1 0 0

# Run hold: reset=0 clears counter (FETCH); stays until run=1
1 2 C 0 1 0
0 2 0 0 1 0
0 2 C 1 0 0
1 2 C 0 1 0

# Mid-flight cycles change: was 2-phase (cy=1), switch to cy=2 at EXECUTE
0 0 C 1 0 0
1 1 C 0 1 0
1 2 0 0 1 0
1 2 C 0 0 1
1 2 C 1 0 0

# cycles=0 lock: never leaves FETCH (unused in ROM)
0 0 C 1 0 0
1 0 C 1 0 0
1 0 C 1 0 0
1 0 C 1 0 0</dataString>
          </testData>
        </entry>
      </elementAttributes>
      <pos x="0" y="-200"/>
    </visualElement>
    <visualElement>
      <elementName>In</elementName>
      <elementAttributes>
        <entry>
          <string>Label</string>
