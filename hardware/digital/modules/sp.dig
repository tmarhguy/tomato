    <visualElement>
      <elementName>Testcase</elementName>
      <elementAttributes>
        <entry>
          <string>Label</string>
          <string>sp-reset-init</string>
        </entry>
        <entry>
          <string>Testdata</string>
          <testData>
            <dataString>sp-op Reset seq-exec sp-load-in CLK sp-out

# Reset=1 loads SP_INIT (0x010000). Reset=0 = run.

0 1 0 0 0 x
0 1 0 0 C 0x010000
0 1 0 0 0 0x010000
</dataString>
          </testData>
        </entry>
      </elementAttributes>
      <pos x="-740" y="140"/>
    </visualElement>
    <visualElement>
      <elementName>Testcase</elementName>
      <elementAttributes>
        <entry>
          <string>Label</string>
          <string>sp-push-pop</string>
        </entry>
        <entry>
          <string>Testdata</string>
          <testData>
            <dataString>sp-op Reset seq-exec sp-load-in CLK sp-out

# Init then PUSH (-4) then POP (+4). Tomato32 native 0x70 / 0x71.
# After PUSH clock, drop sp-op to HOLD before checking sp-out (addr mux = sp_next while PUSH).

0 1 0 0 0 x
0 1 0 0 C 0x010000
0 0 0 0 0 0x010000
2 0 0 0 0 0x00FFFC
2 0 1 0 C x
0 0 0 0 0 0x00FFFC
1 0 0 0 0 0x00FFFC
1 0 1 0 C x
0 0 0 0 0 0x010000
</dataString>
          </testData>
        </entry>
      </elementAttributes>
      <pos x="-740" y="320"/>
    </visualElement>
    <visualElement>
      <elementName>Testcase</elementName>
      <elementAttributes>
        <entry>
          <string>Label</string>
          <string>sp-seq-gate</string>
        </entry>
        <entry>
          <string>Testdata</string>
          <testData>
            <dataString>sp-op Reset seq-exec sp-load-in CLK sp-out

# reg_en = (|sp-op &amp; seq-exec) | Reset — no SP register change without seq-exec.

0 1 0 0 C 0x010000
0 0 0 0 0 0x010000
2 0 0 0 C x
0 0 0 0 0 0x010000
0 0 1 0 C 0x010000
0 0 1 0 0 0x010000
2 0 0 0 0 x
0 0 0 0 0 0x010000
</dataString>
          </testData>
        </entry>
      </elementAttributes>
      <pos x="-720" y="520"/>
    </visualElement>
    <visualElement>
      <elementName>Testcase</elementName>
      <elementAttributes>
        <entry>
          <string>Label</string>
          <string>sp-addr-mux</string>
        </entry>
        <entry>
          <string>Testdata</string>
          <testData>
            <dataString>sp-op Reset seq-exec sp-load-in CLK sp-out

# PUSH (sp-op=2) drives sp_next on sp-out; POP (sp-op=1) drives registered top.
# Combinatorial only — no EXEC clock (PUSH+seq-exec after edge re-exposes decremented sp_next).

0 1 0 0 C 0x010000
0 0 0 0 0 0x010000
2 0 0 0 0 0x00FFFC
1 0 0 0 0 0x010000
0 0 0 0 0 0x010000
</dataString>
          </testData>
        </entry>
      </elementAttributes>
      <pos x="-720" y="700"/>
    </visualElement>
  </visualElements>
