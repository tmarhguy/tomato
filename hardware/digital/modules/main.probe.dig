        <entry>
          <string>Testdata</string>
          <testData>
            <dataString>reset clk pc-out ir-opcode
# EEPROM loop: ADDI x3, ADD, JMP rel 3 (0x62000003, IR[0]=1)
1 0 x x
1 1 x x
1 0 x x
1 1 1 0x10
1 0 x x
1 1 x x
1 0 x x
1 1 2 0x10
1 0 x x
1 1 x x
1 0 x x
1 1 3 0x10
1 0 x x
1 1 x x
1 0 x x
1 1 4 0x01
1 0 x x
1 1 x x
1 0 x x
1 1 3 0x62
</dataString>
