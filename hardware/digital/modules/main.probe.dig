    <visualElement>
      <elementName>Testcase</elementName>
      <elementAttributes>
        <entry>
          <string>Label</string>
          <string>lw-pipeline</string>
        </entry>
        <entry>
          <string>Testdata</string>
          <testData>
            <dataString>reset clk alu-out ctrl-reg-we ir-opcode pc-out
# EEPROM: ADDI R0=0 -&gt; ADDI R1=10 -&gt; ADDI R2=10 -&gt; ADD R2+=R1 -&gt; JMP 3 (loop)
# Counter: R2 increments by 10 each iteration (10+10=20, 20+10=30, ...)
1 0 x x x x
1 1 x x x x
1 0 x x x x
# EXECUTE ADDI R0=r0+0=0
1 1 0 1 0x10 1
1 0 x x x x
1 1 x x x x
1 0 x x x x
# EXECUTE ADDI R1=r0+10=10
1 1 10 1 0x10 2
1 0 x x x x
1 1 x x x x
1 0 x x x x
# EXECUTE ADDI R2=r0+10=10
1 1 10 1 0x10 3
1 0 x x x x
1 1 x x x x
1 0 x x x x
# EXECUTE ADD iter1: R2 written=20, write-through re-reads R2=20, shows 20+10=30
1 1 30 1 0x01 4
1 0 x x x x
1 1 x x x x
1 0 x x x x
# EXECUTE JMP 3 — PC reloads to word 3
1 1 x 0 0x62 3
1 0 x x x x
1 1 x x x x
1 0 x x x x
# EXECUTE ADD iter2: R2 written=30, shows 30+10=40
1 1 40 1 0x01 4
1 0 x x x x
1 1 x x x x
1 0 x x x x
# EXECUTE JMP — PC back to 3
1 1 x 0 0x62 3
1 0 x x x x
1 1 x x x x
1 0 x x x x
# EXECUTE ADD iter3: R2 written=40, shows 40+10=50
1 1 50 1 0x01 4
</dataString>
          </testData>
        </entry>
      </elementAttributes>
      <pos x="780" y="-880"/>
    </visualElement>
    <visualElement>
      <elementName>Testcase</elementName>
      <elementAttributes>
        <entry>
          <string>Label</string>
          <string>load-store-chain</string>
        </entry>
        <entry>
          <string>Testdata</string>
          <testData>
            <dataString>reset clk alu-out ctrl-reg-we ir-opcode
# Counter loop (picks up mid-run, R2 already at 40 after lw-pipeline test above)
# This is an independent run — 3 more ADD iterations: 20, 30, 40
1 0 x x x
1 1 x x x
1 0 x x x
1 1 x x x
1 0 x x x
1 1 x x x
1 0 x x x
1 1 x x x
1 0 x x x
1 1 x x x
1 0 x x x
1 1 x x x
1 0 x x x
# ADD first iteration: R2=20
1 1 20 1 0x01
1 0 x x x
1 1 x x x
1 0 x x x
1 1 x 0 0x62
1 0 x x x
1 1 x x x
1 0 x x x
# ADD second iteration: R2=30
1 1 30 1 0x01
</dataString>
          </testData>
        </entry>
      </elementAttributes>
