        <entry>
          <string>Testdata</string>
          <testData>
            <dataString>clk ~SR ~PE D Q

# 24-bit synchronous counter (6×74163)
# ~PE=1 count, ~PE=0 parallel load from D; C = rising clock edge


# 1. Sync reset from unknown

0 1 1 0x000000 0x000000
C 0 1 0x000000 0x000000
0 1 1 0x000000 0x000000

# 2. Count 0 → 1 → 2

C 1 1 0x000000 0x000001
0 1 1 0x000000 0x000001
C 1 1 0x000000 0x000002
0 1 1 0x000000 0x000002

# 3. Nibble carry 0x0E → 0x0F → 0x10

C 1 1 0x000000 0x000003
0 1 1 0x000000 0x000003
C 1 1 0x000000 0x000004
0 1 1 0x000000 0x000004
C 1 1 0x000000 0x000005
