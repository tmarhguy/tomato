        </entry>
        <entry>
          <string>Testdata</string>
          <testData>
            <dataString>RESET cycles clk FETCH EXECUTE MEM-WAIT

# From sequencer.dig; RESET active-high hold (invert main reset)
# RESET=1 hold, RESET=0 run

# Sync after prog-count-2-smoke (phase may not be FETCH)
1 0 C x x x

# Hold (RESET=1): counter cleared — FETCH
1 0 0 1 0 0
1 0 C 1 0 0

# Release run (RESET=0), cycles=0: single-phase (FETCH only)
0 0 0 1 0 0
0 0 C 1 0 0
0 0 C 1 0 0

# cycles=1: FETCH -&gt; EXECUTE -&gt; FETCH (2 phases)
0 1 0 1 0 0
0 1 C 0 1 0
0 1 C 1 0 0
0 1 C 0 1 0
0 1 C 1 0 0

# cycles=2: FETCH -&gt; EXECUTE -&gt; MEM_WAIT -&gt; FETCH (3 phases)
0 2 0 1 0 0
0 2 C 0 1 0
0 2 C 0 0 1
0 2 C 1 0 0
0 2 C 0 1 0
0 2 C 0 0 1
0 2 C 1 0 0

# cycles=3: four counter steps — terminal reload at 11
0 3 0 1 0 0
0 3 C 0 1 0
0 3 C 0 0 1
0 3 C 0 0 0
0 3 C 1 0 0

# Run hold: RESET=1 clears counter (FETCH)
0 2 C 0 1 0
1 2 0 0 1 0
1 2 C 1 0 0
0 2 C 0 1 0

# Mid-flight cycles change
1 0 C 1 0 0
0 1 C 0 1 0
0 2 0 0 1 0
0 2 C 0 0 1
0 2 C 1 0 0

# cycles=0 lock: never leaves FETCH
1 0 C 1 0 0
0 0 C 1 0 0
0 0 C 1 0 0
0 0 C 1 0 0</dataString>
          </testData>
        </entry>
      </elementAttributes>
