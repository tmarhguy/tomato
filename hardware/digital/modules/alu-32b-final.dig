          <testData>
            <dataString>A nz0 B REG_C Opcode control cin-sel FLAG_C Out vout zout nzout nout cout

# SECTION 1: CPU microcode encodings (main.v ALU paths)
# ADD — microcode 0x01
0x00000005 0 0x00000003 0x00000000 0x96 5 0 0 0x00000008 0 0 1 0 0
0xFFFFFFFF 0 0x00000001 0x00000000 0x96 5 0 0 0x00000000 0 1 0 0 1
0x80000000 0 0x80000000 0x00000000 0x96 5 0 0 0x00000000 1 1 0 0 1

# SUB — microcode 0x02
0x0000000A 0 0x00000003 0x00000000 0x96 13 1 0 0x00000007 0 0 1 0 1
0x00000005 0 0x0000000A 0x00000000 0x96 13 1 0 0xFFFFFFFB 0 0 1 1 0

# AND — microcode 0x03
0xFF00FF00 0 0x0F0F0F0F 0x00000000 0x88 5 0 0 0x0E0F0E00 0 0 1 0 1

# OR — microcode 0x04
0xFF00FF00 0 0x0F0F0F0F 0x00000000 0xEE 5 0 0 0xFF1FFF0F 0 0 1 1 1

# XOR — microcode 0x05
0xFF00FF00 0 0x0F0F0F0F 0x00000000 0x66 5 0 0 0xF110F10F 0 0 1 1 1

# NOT — microcode 0x06
0xAAAAAAAA 0 0x00000000 0x00000000 0x33 1 0 0 0xFFFFFFFF 0 0 1 1 0

# LDI_pass_B — microcode 0x22 literal on B
0x00000000 0 0x0000DEAD 0x00000000 0xCC 4 0 0 0x0000DEAD 0 0 1 0 0
0x00000000 0 0x12345678 0x00000000 0xCC 4 0 0 0x12345678 0 0 1 0 0

# LUT3_PASS_C — LUT3 addr-csel=1
0xFFFFFFFF 0 0x00000000 0x55555555 0xAA 21 0 0 0x55555555 0 0 1 0 1

# LUT2_XOR — direct LUT2 band
0xF0F0F0F0 0 0x0F0F0F0F 0x00000000 0x3C 5 0 0 0xFFFFFFFF 0 0 1 1 0

# SECTION 2: carry / overflow corner cases (ADD)
0x7FFFFFFF 0 0x00000001 0x00000000 0x96 5 0 0 0x80000000 1 0 1 1 0
0x80000000 0 0xFFFFFFFF 0x00000000 0x96 5 0 0 0x7FFFFFFF 1 0 1 0 1
0x0000000A 0 0x00000005 0x00000000 0x96 5 0 0 0x0000000F 0 0 1 0 0

# SECTION 3: 3-input LUT samples (control=10101)
0xAAAAAAAA 0 0x00000000 0x55555555 0x5A 21 0 0 0xFFFFFFFF 0 0 1 1 0
0xAAAAAAAA 0 0x00000000 0x55555555 0xA0 21 0 0 0x00000000 0 1 0 0 0
0xAAAAAAAA 0 0x00000000 0x55555555 0xFA 21 0 0 0xFFFFFFFF 0 0 1 1 0
</dataString>
          </testData>
