    <visualElement>
      <elementName>Testcase</elementName>
      <elementAttributes>
        <entry>
          <string>Label</string>
          <string>byte-lane spot-check</string>
        </entry>
        <entry>
          <string>Testdata</string>
          <testData>
            <dataString>mem-in sel-in io-data-in c-addr-msb2 mem-out

# A — word pass-through (sel=0: mem_sel=0, c-addr-msb2=0)
0xAABBCCDD 0 0 0 0xAABBCCDD
0x01020304 0 0 0 0x01020304

# B — byte swap for stores (sel=1)
0xAABBCCDD 1 0 0 0xDDCCBBAA

# C — IO read path (sel=2)
0x00000000 2 0xDEADBEEF 0 0xDEADBEEF

# D — sign-extend byte0 (sel=4: mem_sel=0, c-addr-msb2=1)
0xAABBCC80 0 0 1 0xFFFFFF80
0x000000FF 0 0 1 0xFFFFFFFF

# E — zero-extend byte0 (sel=8: mem_sel=0, c-addr-msb2=2)
0xAABBCCDD 0 0 2 0x000000DD

# F — sign-extend byte1 (sel=5: mem_sel=1, c-addr-msb2=1)
0x0000807F 1 0 1 0xFFFFFF80

# G — sign-extend half (sel=12: mem_sel=0, c-addr-msb2=3)
0xAABB8000 0 0 3 0xFFFF8000

# H — zero-extend half (sel=14: mem_sel=2, c-addr-msb2=3)
0xAABBCCDD 2 0 3 0x0000CCDD
</dataString>
          </testData>
        </entry>
      </elementAttributes>
      <pos x="200" y="-660"/>
    </visualElement>
