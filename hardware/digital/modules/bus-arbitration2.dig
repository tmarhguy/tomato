          <testData>
            <dataString>FETCH MEM_RD_IN PC_OUT IR_ADDR reg_a addr_sel ADDR_BUS MEM_RD_OUT

# bus-arbitration.v: sel={FETCH,addr_sel}  MEM_RD_OUT = MEM_RD_IN | FETCH

# A. All 8 control corners (tagged PC/IR/reg_a)
0 0 0x00AA01 0x00BB02 0x00CC03 0 0x00AA01 0
