        <entry>
          <string>Testdata</string>
          <testData>
            <dataString>FETCH MEM_RD_IN PC_OUT IR_ADDR reg_a addr_sel ADDR_BUS MEM_RD_OUT

# bus-arbitration.v: sel={FETCH,addr_sel}  MEM_RD_OUT = MEM_RD_IN | FETCH

# A. All 8 control corners (tagged PC/IR/reg_a)
0 0 0x00AA01 0x00BB02 0x00CC03 0 0x00AA01 0
0 1 0x00AA01 0x00BB02 0x00CC03 0 0x00AA01 1
0 0 0x00AA01 0x00BB02 0x00CC03 1 0x00BB02 0
0 1 0x00AA01 0x00BB02 0x00CC03 1 0x00BB02 1
1 0 0x00AA01 0x00BB02 0x00CC03 0 0x00AA01 1
1 1 0x00AA01 0x00BB02 0x00CC03 0 0x00AA01 1
1 0 0x00AA01 0x00BB02 0x00CC03 1 0x00CC03 1
1 1 0x00AA01 0x00BB02 0x00CC03 1 0x00CC03 1

# B. Four address modes (smoke)
0 0 0x000001 0x000002 0x000003 0 0x000001 0
0 0 0x000001 0x000002 0x000003 1 0x000002 0
1 0 0x000001 0x000002 0x000003 0 0x000001 1
1 0 0x000001 0x000002 0x000003 1 0x000003 1

# C. MEM_RD_OUT truth (FETCH OR MEM_RD_IN)
