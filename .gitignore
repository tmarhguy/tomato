.cursor/
.env

# Website
website/node_modules/
website/dist/
website/.vite/

.venv-vga/

# Python
*.pyc
**/__pycache__/

# KiCad
*.kicad_prl
*.dsn
*~*.lck
*-backups/

# FPGA Tomato Icarus sim artifacts
hardware/fpga/tomato/sim/

# Keep burn boot marker tracked despite *.txt
!hardware/fpga/tomato/rtl/burn/BOOT.txt

# Xilinx Vivado — generated outputs (keep *.xpr and *.srcs/constrs)
hardware/fpga/*/*.cache/
hardware/fpga/*/*.runs/
hardware/fpga/*/*.hw/
hardware/fpga/**/.Xil/
hardware/fpga/**/.jobs/
hardware/fpga/**/*.jou
hardware/fpga/**/*.pb
hardware/fpga/**/*.rpt
hardware/fpga/**/*.rpx
hardware/fpga/**/*.dcp
hardware/fpga/**/*.bit
hardware/fpga/**/*.vdi
hardware/fpga/**/*.wdf
hardware/fpga/**/*.wpc
hardware/fpga/**/ISEWrap.js
hardware/fpga/**/ISEWrap.sh
hardware/fpga/**/rundef.js
hardware/fpga/**/runme.bat
hardware/fpga/**/runme.sh
hardware/fpga/**/runme.log
hardware/fpga/**/gen_run.xml
hardware/fpga/**/.vivado*.rst
hardware/fpga/**/.Vivado*.rst
hardware/fpga/**/utils_1/

# Digital Verilog exports (copy locally for sim/formal; not source-of-truth in git)
*.txt

# Verification — hand-authored Verilog (exceptions to *.v above)
!verification/formal/*_bind.v
!verification/directed/alu_ref.v
!verification/directed/alu_32b_dut_wrap.v
!verification/directed/alu-32b-final*_tb.v

# Verification — build artifacts (make clean)
verification/work/
verification/results/
verification/formal/alu_*_verify/
verification/formal/alu_*_prove/
verification/directed/run_extracted_tb.v

# Verification synthesis — generated reports and fetched PDK liberty
verification/synthesis/reports/
verification/synthesis/pdk/*.lib

# Test benchmark — generated reports
test/reports/

*.zip
/hardware/kicad/boards/07_alu/.history
