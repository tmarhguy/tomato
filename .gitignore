.DS_Store
node_modules/

# Obsidian / editor
.obsidian/
.trash/
.cursor/
.env
.vscode/

.venv-vga/

# Python
*.pyc
**/__pycache__/

# KiCad
*.kicad_prl
*.dsn
*~*.lck
*-backups/

# FPGA Icarus sim artifacts (regenerated by `make test`)
hardware/fpga/core/sim/

# Open-source FPGA flow: per-project build output, and the shared ~2.7 GB
# toolchain (OSS CAD Suite + prjxray) that `make setup` installs under
# hardware/fpga/.tools/. A fresh clone does NOT ship these — run setup once
# only when you want a bitstream. Simulation needs only Icarus + Python 3.
hardware/fpga/*/build/
hardware/fpga/.tools/
hardware/fpga/**/*.bit

# Scratch / Digital export dumps / formal engine logs (not source of truth)
*.txt
# Burn boot marker must stay so clones know which dmem image is active.
!hardware/fpga/core/rtl/burn/BOOT.txt

# Verification — keep hand-authored bind/wrap/TB Verilog tracked
!verification/formal/*_bind.v
!verification/directed/alu_ref.v
!verification/directed/alu_32b_dut_wrap.v
!verification/directed/alu-32b-final*_tb.v

# Verification — build artifacts (make clean)
verification/work/
verification/results/
verification/formal/alu_*_verify/
verification/formal/alu_*_prove/
verification/directed/run_extracted_tb.v

# Gauntlet (FPGA ALU Verilator / SymbiYosys)
verification/gauntlet/obj/
verification/gauntlet/results/
verification/gauntlet/formal/alu*_verify/
!verification/gauntlet/rtl/alu.v
!verification/gauntlet/formal/*.v
!verification/gauntlet/verilator/*

# Verification synthesis — generated reports and fetched PDK liberty
verification/synthesis/reports/
verification/synthesis/pdk/*.lib

# Test benchmark — generated reports
test/reports/

# Keep FPGA metric summaries tracked
!hardware/fpga/core/reports/
!hardware/fpga/core/reports/**
!verification/formal/PROPERTY_INVENTORY.md

*.zip
**/.history/
*.jou
vivado.log
/scratch
# media/ is the bench archive and is tracked. Do not ignore it — Cursor/VS Code
# paint tracked-but-ignored paths with "!", which hid the 92 stills and clips.
# Optimized site copies live under web/assets.
