read_verilog rtl/kogge_stone_32.v
read_verilog rtl/alu_lut_planes_32.v
read_verilog rtl/alu-32b-koggestone.v
hierarchy -top alu_32b_kogge_stone
synth -top alu_32b_kogge_stone
dfflibmap -liberty ../verification/synthesis/pdk/sky130_fd_sc_hd__tt_025C_1v80.lib
abc -liberty ../verification/synthesis/pdk/sky130_fd_sc_hd__tt_025C_1v80.lib
opt_clean
stat -liberty ../verification/synthesis/pdk/sky130_fd_sc_hd__tt_025C_1v80.lib
ltp
flatten
write_verilog -noattr reports/alu_ks_mapped.v
